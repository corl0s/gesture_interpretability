#!/bin/bash -l
# BU SCC (SGE) job for ONE experiment step. Submit through submit_full_scale.sh.
# Submit from the repo root (logs/ must exist): qsub -v STEP=...,MODEL=...,OUT=...,ARGS="..." jobs/scc_experiment.qsub
#$ -P mlresearch
#$ -N deixis
#$ -l h_rt=12:00:00
#$ -l gpus=1
#$ -l gpu_c=8.0
#$ -l gpu_memory=40G
#$ -pe omp 4
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log

set -eo pipefail
cd "$SGE_O_WORKDIR"
module unload miniconda academic-ml 2>/dev/null || true   # conflicts with the python3 module
module load python3/3.12.4
module load cuda/12.8
source .venv/bin/activate          # created once: see jobs/scc_setup.sh
set -u
# Optional per-job env file (written by submit_full_scale.sh) carries ARGS verbatim.
if [ -n "${ENVFILE:-}" ]; then source "$ENVFILE"; fi
# Shared read-only HF cache (Qwen3-VL 2B/4B/8B/32B); write-side HF state stays in the repo dir.
export HF_HUB_CACHE=/projectnb/bu-mlb/materials/hf_cache/hub
export HF_HOME=/projectnb/bu-mlb/vishnuav/deixis/hf_home
export HF_HUB_OFFLINE=1
export PYTHONIOENCODING=utf-8
export OMP_NUM_THREADS=${NSLOTS:-4}
nvidia-smi --query-gpu=name,memory.total --format=csv
echo "STEP=$STEP MODEL=$MODEL OUT=$OUT ARGS=${ARGS:-}"
python experiments/$STEP.py --model "$MODEL" --out "$OUT" ${ARGS:-}
